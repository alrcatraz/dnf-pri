#!/bin/bash

# --- Global Configuration & Cleanup ---
TEMP_DATA="/tmp/dnf_pri.tmp"
trap "rm -f $TEMP_DATA ${TEMP_DATA}.final" EXIT

# --- Utility Functions ---

# Function: Display help information
show_help()
{
    echo "dnf-pri is a tool to quickly lookup and set priority for dnf repositories installed"

    local sub_cmd=$1
    if [[ "$sub_cmd" == "set" ]]; then
        echo "Usage: dnf-pri set <repo-id> [priority | --option value]"
        echo "Description: Modify repository settings. Defaults to setting priority if a number is provided."
        echo ""
        echo "Examples:"
        echo "  sudo dnf-pri set fedora 10                  # Set priority to 10"
        echo "  sudo dnf-pri set epel --disable             # Disable the repository"
        echo "  sudo dnf-pri set epel --includepkgs rime    # Set 'includepkgs' option"
    else
        echo "Usage: dnf-pri [COMMAND] [OPTIONS]"
        echo ""
        echo "Commands:"
        echo "  (default)             List all enabled repositories and their priorities"
        echo "  set <id> <pri>        Set priority for a specific repository"
        echo "  help                  Show this help message"
        echo ""
        echo "Options for listing:"
        echo "  --all                 Show all repositories (including disabled ones)"
        echo "  --sort [id|name|pri]  Sort the output table (default: id)"
    fi
}

draw_progress_bar() {
    local current=$1 total=$2
    local term_width=$(tput cols 2>/dev/null || echo 80)
    local bar_max_width=$(( term_width - 45 ))
    [[ $bar_max_width -lt 10 ]] && bar_max_width=10
    [[ $bar_max_width -gt 50 ]] && bar_max_width=50

    local progress=$(( current * bar_max_width / total ))
    local percent=$(( current * 100 / total ))
    local bar_filled=$(printf "%${progress}s" | tr ' ' '=')
    local bar_empty=$(printf "%$(( bar_max_width - progress ))s")
    
    printf "\rProgress: [%s>%s] %d%% (%d/%d)" "$bar_filled" "$bar_empty" "$percent" "$current" "$total" >&2
}

# --- Command Functions ---

cmd_list() {
    local sort_rule="id"
    local scope="--enabled"
    
    # Simple argument parsing for list
    while [[ "$#" -gt 0 ]]; do
        case $1 in
            --all) scope="--all" ;;
            --sort) sort_rule="$2"; shift ;;
            id|name|pri) sort_rule="$1" ;; # legacy support
        esac
        shift
    done

    local repos=($(dnf repolist -q $scope | awk 'NR>0 {print $1}'))
    local total_repos=${#repos[@]}

    [[ "$total_repos" -eq 0 ]] && { echo "No repositories found."; return; }

    echo "Fetching metadata (Scope: $scope, Sort: $sort_rule)..." >&2
    > "$TEMP_DATA"

    local count=0
    for repo in "${repos[@]}"; do
        ((count++))
        draw_progress_bar "$count" "$total_repos"

        local conf=$(dnf config-manager --dump "$repo" 2>/dev/null)
        [[ -z "$conf" ]] && continue
        
        local name=$(echo "$conf" | grep "^name =" | cut -d'=' -f2- | xargs)
        local pri=$(echo "$conf" | grep "^priority =" | cut -d'=' -f2- | xargs)
        local enabled=$(echo "$conf" | grep "^enabled =" | cut -d'=' -f2- | xargs)
        
        [[ -z "$pri" ]] && pri="99"
        local status="Disabled"
        [[ "$enabled" == "1" ]] && status="Enabled"
        
        echo "$repo|$name|$pri|$status" >> "$TEMP_DATA"
    done
    echo -e "\n" >&2

    # Prepare table
    echo "REPO_ID|REPO_NAME|PRIORITY|STATUS" > "${TEMP_DATA}.final"
    echo "-------|---------|--------|------" >> "${TEMP_DATA}.final"

    case $sort_rule in
        name) sort -t'|' -k2 -f "$TEMP_DATA" >> "${TEMP_DATA}.final" ;;
        pri)  sort -t'|' -k3 -n -s "$TEMP_DATA" >> "${TEMP_DATA}.final" ;;
        *)    sort -t'|' -k1 -f "$TEMP_DATA" >> "${TEMP_DATA}.final" ;;
    esac

    column -t -s '|' "${TEMP_DATA}.final" 2>/dev/null || cat "${TEMP_DATA}.final" | tr '|' '\t'
}

# Function: Set repository priority
cmd_set()
{
    local target=$1
    local priority=$2

    if [[ -z "$target" || -z "$priority" ]]; then
        show_help "set"
        exit 1
    fi

    # Check if numeric
    if [[ ! "$priority" =~ ^[0-9]+$ ]]; then
        echo "Error: Priority must be a number." >&2
        exit 1
    fi

    # Require root for config-manager --save
    if [[ $EUID -ne 0 ]]; then
        echo "Error: This command requires root privileges. Please use sudo." >&2
        exit 1
    fi

    echo "Updating repository '$target' priority to $priority..."
    dnf config-manager --save --setopt="${target}.priority=${priority}"
    
    if [ $? -eq 0 ]; then
        echo "Success: Priority updated."
    else
        echo "Error: Failed to update priority. Check if repo ID is correct." >&2
        exit 1
    fi
}

# --- Main Router ---

case "$1" in
    set) shift; cmd_set "$@" ;;
    help|--help|-h) shift; show_help "$@" ;;
    *)
        # Check if user passed --all or --sort directly
        if [[ "$1" == "--all" || "$1" == "--sort" || -z "$1" || "$1" =~ ^(id|name|pri)$ ]]; then
            cmd_list "$@"
        else
            echo "Error: Unknown command '$1'"; show_help; exit 1
        fi
        ;;
esac
