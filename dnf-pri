# --- Global Configuration & Cleanup ---
TEMP_DATA="/tmp/dnf_pri.tmp"
trap "rm -f $TEMP_DATA ${TEMP_DATA}.final" EXIT

# --- Detect DNF Version ---
if dnf --version 2>/dev/null | grep -iq "dnf5"; then
    IS_DNF5=1
else
    IS_DNF5=0
fi

# --- Utility Functions ---

# Function: Display help information
show_help()
{
    echo "dnf-pri is a tool to quickly lookup and set priority for dnf repositories installed"

    local sub_cmd=$1
    if [[ "$sub_cmd" == "set" ]]; then
        echo "Usage: dnf-pri set <repo-id> [priority | --option value]"
        echo "Description: Modify repository settings. Defaults to setting priority if a number is provided."
        echo ""
        echo "Examples:"
        echo "  sudo dnf-pri set fedora 10                  # Set priority to 10"
        echo "  sudo dnf-pri set epel --disable             # Disable the repository"
        echo "  sudo dnf-pri set epel --includepkgs rime    # Set 'includepkgs' option"
    else
        echo "Usage: dnf-pri [COMMAND] [OPTIONS]"
        echo ""
        echo "Commands:"
        echo "  (default)             List enabled repositories and their priorities"
        echo "  set <id> <val/opt>    Modify repository priority or other options"
        echo "  help [command]        Show this help or help for a specific command"
        echo ""
        echo "Options for listing:"
        echo "  --all                 Show all repositories (including disabled ones)"
        echo "  --sort [id|name|pri]  Sort the output table (default: id)"
    fi
}

draw_progress_bar() {
    local current=$1 total=$2
   
    local term_width=$(tput cols 2>/dev/null || echo 80)
    local bar_max_width=$(( term_width - 45 ))
    [[ $bar_max_width -lt 10 ]] && bar_max_width=10
    [[ $bar_max_width -gt 50 ]] && bar_max_width=50

    local progress=$(( current * bar_max_width / total ))
    local percent=$(( current * 100 / total ))
    local bar_filled=$(printf "%${progress}s" | tr ' ' '=')
    local bar_empty=$(printf "%$(( bar_max_width - progress ))s")
    
    printf "\rProgress: [%s>%s] %d%% (%d/%d)" "$bar_filled" "$bar_empty" "$percent" "$current" "$total" >&2
}

# --- Command Functions ---

cmd_list() {
    local sort_rule="id"
    local scope=""
    local dnf4_scope="--enabled"
    
    # Simple argument parsing for list
    while [[ "$#" -gt 0 ]]; do
        case $1 in
            --all) scope="--all"; dnf4_scope="--all" ;;
            --sort) sort_rule="$2"; shift ;;
            id|name|pri) sort_rule="$1" ;; # legacy support
        esac
        shift
    done

    # Extract repositories safely depending on the DNF version
    if [[ "$IS_DNF5" -eq 1 ]]; then
        # Use awk to start grabbing from the line AFTER the header "repo id" or "仓库 ID"
        local repos=($(dnf repo list $scope 2>/dev/null | awk '
            BEGIN { start=0 }
            /^repo id/ || /^仓库 ID/ { start=1; next }
            start==1 && NF>0 { print $1 }
        '))
        
        # Fallback just in case headers are entirely different in other languages
        if [[ ${#repos[@]} -eq 0 ]]; then
            local repos=($(dnf repo list $scope 2>/dev/null | awk 'NR>1 {print $1}'))
        fi
    else
        local repos=($(dnf repolist -q $dnf4_scope 2>/dev/null | awk 'NR>0 {print $1}'))
    fi
    
    local total_repos=${#repos[@]}

    [[ "$total_repos" -eq 0 ]] && { echo "No repositories found."; return; }

    echo "Fetching metadata (Scope: ${scope:-"--enabled"}, Sort: $sort_rule)..." >&2
    > "$TEMP_DATA"

    local count=0
    for repo in "${repos[@]}"; do
        ((count++))
        draw_progress_bar "$count" "$total_repos"

        if [[ "$IS_DNF5" -eq 1 ]]; then
            # The correct option for DNF5 is --dump-repo-config 
            local conf=$(dnf --dump-repo-config="$repo" 2>/dev/null)
        else
            local conf=$(dnf config-manager --dump "$repo" 2>/dev/null)
        fi
        
        [[ -z "$conf" ]] && continue
        
        local name=$(echo "$conf" | grep "^name =" | cut -d'=' -f2- | xargs)
        local pri=$(echo "$conf" | grep "^priority =" | cut -d'=' -f2- | xargs)
        local enabled=$(echo "$conf" | grep "^enabled =" | cut -d'=' -f2- | xargs)
        
        [[ -z "$pri" ]] && pri="99"
        local status="Disabled"
        [[ "$enabled" == "1" ]] && status="Enabled"
        
        echo "$repo|$name|$pri|$status" >> "$TEMP_DATA"
    done
    echo -e "\n" >&2

    # Prepare table
    echo "REPO_ID|REPO_NAME|PRIORITY|STATUS" > "${TEMP_DATA}.final"
    echo "-------|---------|--------|------" >> "${TEMP_DATA}.final"

    case $sort_rule in
        name) sort -t'|' -k2 -f "$TEMP_DATA" >> "${TEMP_DATA}.final" ;;
        pri)  sort -t'|' -k3 -n -s "$TEMP_DATA" >> "${TEMP_DATA}.final" ;;
        *)    sort -t'|' -k1 -f "$TEMP_DATA" >> "${TEMP_DATA}.final" ;;
    esac

    column -t -s '|' "${TEMP_DATA}.final" 2>/dev/null || cat "${TEMP_DATA}.final" | tr '|' '\t'
}

cmd_set() {
    local target=$1
    shift
    local first_arg=$1

    [[ -z "$target" || -z "$first_arg" ]] && { show_help "set"; exit 1; }
    [[ $EUID -ne 0 ]] && { echo "Error: Please run as root (sudo)." >&2; exit 1; }

    # Logic: If first_arg is a number, set priority. Otherwise, treat as flags.
    if [[ "$first_arg" =~ ^[0-9]+$ ]]; then
        echo "Setting priority of '$target' to $first_arg..."
        if [[ "$IS_DNF5" -eq 1 ]]; then
            dnf config-manager setopt "${target}.priority=${first_arg}"
        else
            dnf config-manager --save --setopt="${target}.priority=${first_arg}"
        fi
    else
        # Pass flags to config-manager based on version
        echo "Updating '$target' with options: $@"
        
        # Handle special cases like --enable / --disable 
        if [[ "$first_arg" == "--enable" ]]; then
            if [[ "$IS_DNF5" -eq 1 ]]; then
                dnf config-manager setopt "${target}.enabled=1"
            else
                dnf config-manager --save --set-enabled "$target"
            fi
        elif [[ "$first_arg" == "--disable" ]]; then
            if [[ "$IS_DNF5" -eq 1 ]]; then
                dnf config-manager setopt "${target}.enabled=0"
            else
                dnf config-manager --save --set-disabled "$target"
            fi
        else
            # For --setopt style: e.g. dnf-pri set epel --includepkgs rime
            local opt_name=$(echo "$first_arg" | sed 's/^--//')
            shift
            local opt_val="$1"
            if [[ "$IS_DNF5" -eq 1 ]]; then
                # New DNF5 Syntax: setopt <repoid>.<option>=<value>
                dnf config-manager setopt "${target}.${opt_name}=${opt_val}"
            else
                # Legacy DNF4 Syntax
                dnf config-manager --save --setopt="${target}.${opt_name}=${opt_val}"
            fi
        fi
    fi

    [[ $? -eq 0 ]] && echo "Success." || echo "Error: Failed to update."
}

# --- Main Router ---

case "$1" in
    set) shift; cmd_set "$@" ;;
    help|--help|-h) shift; show_help "$@" ;;
    *)
        # Check if user passed --all or --sort directly
        if [[ "$1" == "--all" || "$1" == "--sort" || -z "$1" || "$1" =~ ^(id|name|pri)$ ]]; then
            cmd_list "$@"
        else
            echo "Error: Unknown command '$1'"; show_help; exit 1
        fi
        ;;
esac
